DJANGO_SECRET_KEY=change-to-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional local-only convenience; never enabled when DJANGO_DEBUG=0.
COMMSOS_DEMO_AUTO_LOGIN=0
# PostgreSQL (set all of these to use PostgreSQL; omitted means local SQLite fallback)
POSTGRES_DB=commsos
POSTGRES_USER=commsos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# AI_MODE=demo produces clearly labeled deterministic demo outputs.
AI_MODE=demo
# AI_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
